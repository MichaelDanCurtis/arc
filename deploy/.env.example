# deploy/hostinger/.env.example
#
# Copy to deploy/hostinger/.env, fill in the required secrets, then feed
# the contents to the Hostinger MCP VPS_createNewProjectV1 `environment`
# argument (NOT to docker-compose directly on the VPS — the MCP injects
# these into the compose project's env file on the box).

# ─── Required ────────────────────────────────────────────────────────────
# JWT signing secret. Min 32 chars; use `openssl rand -hex 32`.
# Rotating this invalidates every existing session token.
ARC_JWT_SECRET=

# Postgres password for the `arc` role. Use `openssl rand -hex 16`.
# Rotating this requires also updating the role: ALTER USER arc WITH PASSWORD ...
POSTGRES_PASSWORD=

# ─── Image tag ───────────────────────────────────────────────────────────
# Which michaeldancurtis/arc-{relay,web} tag to deploy. Use `latest` for
# the current build, or pin to a git short-SHA for deterministic rollbacks.
ARC_TAG=latest

# ─── OAuth (optional — leave blank to disable a provider) ────────────────
ARC_OAUTH_REDIRECT_BASE=https://arc.ailuxis.com
ARC_OAUTH_GOOGLE_CLIENT_ID=
ARC_OAUTH_GOOGLE_CLIENT_SECRET=
ARC_OAUTH_MICROSOFT_CLIENT_ID=
ARC_OAUTH_MICROSOFT_CLIENT_SECRET=
ARC_OAUTH_GITHUB_CLIENT_ID=
ARC_OAUTH_GITHUB_CLIENT_SECRET=

# ─── Cloudflare R2 (optional — marketplace plugin uploads) ───────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=beacon-plugins

# ─── Frontend API base URL ───────────────────────────────────────────────
# Only used as a fallback for the runtime value. The build-time NEXT_PUBLIC_
# version is baked into the browser bundle when the arc-web image was built,
# so change this for local testing only.
NEXT_PUBLIC_ARC_RELAY_URL=https://arc.ailuxis.com

# ─── Logging ─────────────────────────────────────────────────────────────
RUST_LOG=arc_relay=info
