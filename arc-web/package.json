{
  "name": "arc-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "wasm:build": "wasm-pack build ../beacon-core/crates/beacon-blocks-wasm --target bundler --out-dir \"$(pwd)/src/wasm/beacon-blocks\" --dev",
    "wasm:build:release": "wasm-pack build ../beacon-core/crates/beacon-blocks-wasm --target bundler --out-dir \"$(pwd)/src/wasm/beacon-blocks\"",
    "prebuild": "npm run wasm:build:release",
    "predev": "[ -f src/wasm/beacon-blocks/beacon_blocks_wasm_bg.wasm ] || npm run wasm:build",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@msgpack/msgpack": "^3.1.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ansi-to-html": "^0.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-window": "^2.2.7",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "jsdom": "^29.0.2",
    "msw": "^2.13.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
